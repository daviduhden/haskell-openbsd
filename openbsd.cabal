cabal-version:      2.4
name:               openbsd
version:            2.4.0
synopsis:           OpenBSD security facilities: pledge(2), unveil(2), privilege dropping
description:
    Haskell bindings for the OpenBSD-specific security interfaces and
    the privilege-separation practice of OpenBSD daemons:
    .
    * pledge(2): restrict the system operations of a process
    * unveil(2): restrict the filesystem view of a process
    * privilege dropping: the setgroups(2) / setresgid(2) /
      setresuid(2) sequence used by OpenBSD base-system daemons
    * chroot(2): change the filesystem root
    * issetugid(2) execution-state detection and getpeereid(3)
      Unix-domain peer credentials
    * setproctitle(3) with format-string injection prevention
    * the arc4random(3) random-number family
    * daemonization using runtime-safe process primitives
    .
    The package can only be built and used on OpenBSD.
category:           System
homepage:           https://github.com/daviduhden/haskell-openbsd
bug-reports:        https://github.com/daviduhden/haskell-openbsd/issues
license:            BSD-3-Clause
license-file:       LICENSE
author:             James Hobson, David Uhden Collado
maintainer:         David Uhden Collado
extra-doc-files:
    README.md

extra-source-files:
    test/fixtures/pledge-empty-probe.c
    test/fixtures/execpledge-probe.c

source-repository head
    type:     git
    location: https://github.com/daviduhden/haskell-openbsd

library
    exposed-modules:
        System.OpenBSD
        System.OpenBSD.Pledge
        System.OpenBSD.Unveil
        System.OpenBSD.Privileges
        System.OpenBSD.Chroot
        System.OpenBSD.Credentials
        System.OpenBSD.Process
        System.OpenBSD.Random
        System.OpenBSD.Rtable
        System.OpenBSD.Memory
        System.OpenBSD.Authentication
    other-modules:
        System.OpenBSD.Internal
    hs-source-dirs:   src
    c-sources:        cbits/openbsd.c
    extra-libraries:  util
    build-depends:
        base       >= 4.11  && < 5,
        unix       >= 2.7   && < 2.9,
        bytestring >= 0.10  && < 0.13
    default-language: Haskell2010
    ghc-options:
        -Wall
        -Wcompat
        -Widentities
        -Wredundant-constraints
        -Wincomplete-uni-patterns
        -Wincomplete-record-updates

test-suite openbsd-tests
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:
        base,
        unix,
        bytestring,
        directory,
        openbsd
    default-language: Haskell2010
    ghc-options:
        -Wall
        -threaded
